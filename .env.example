# Syndication pipeline credentials. Copy to .env (or set as CI secrets) and fill in.
# Every variable is optional: scripts dry-run and exit 0 when a token is missing.

# dev.to API key — https://dev.to/settings/extensions ("DEV Community API Keys")
DEV_TO_API_KEY=

# Hashnode Personal Access Token — https://hashnode.com/settings/developer
# (GraphQL publishing requires Hashnode Pro, $50/yr)
HASHNODE_TOKEN=
# Hashnode publication ObjectId — from your publication dashboard URL or the API
HASHNODE_PUBLICATION_ID=

# WeChat Official Account — https://mp.weixin.qq.com -> 设置与开发 -> 基本配置
WECHAT_APPID=
WECHAT_SECRET=

# Zenodo personal access token — https://zenodo.org/account/settings/applications/
# (scopes: deposit:write, deposit:actions)
ZENODO_TOKEN=
# Zenodo API base URL — set to https://sandbox.zenodo.org/api for testing
# ZENODO_BASE_URL=https://sandbox.zenodo.org/api
