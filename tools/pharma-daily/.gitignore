.venv/
__pycache__/
uv.lock
# keep the accumulated deals DB and the daily packs in git — they are the
# longitudinal asset (comps percentiles) and the PR review artifact
data/*
!data/pharma.db
out/*
!out/pack/
out/pack/*
!out/pack/*.json
# LLM loop artifacts are longitudinal assets too: grill questions, evidence
# cards, critique reports
!out/questions/
out/questions/*
!out/questions/*.json
!out/evidence/
out/evidence/*
!out/evidence/*.json
!out/review/
out/review/*
!out/review/*.md
