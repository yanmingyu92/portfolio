---
// Per-publication abstract page.
// Carries Highwire Press citation_* meta tags (Google Scholar's documented
// indexing format) plus JSON-LD ScholarlyArticle for general search/AI crawlers.
import '../../styles/global.css';
import { publications, getPublication, citationDate } from '../../data/publications';

export function getStaticPaths() {
	return publications.map(p => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const pub = getPublication(slug)!;

const pageUrl = `https://jaimeyan.com/papers/${pub.slug}.html`;
const pdfAbsUrl = pub.pdfUrl ? `https://jaimeyan.com${pub.pdfUrl}` : null;
const venueTag =
	pub.type === 'journal' ? 'citation_journal_title'
	: pub.type === 'conference' || pub.type === 'poster' ? 'citation_conference_title'
	: null;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ScholarlyArticle',
	headline: pub.title,
	author: pub.authors.map(name => ({ '@type': 'Person', name })),
	datePublished: citationDate(pub),
	isPartOf: { '@type': pub.type === 'journal' ? 'Periodical' : 'PublicationEvent', name: pub.venue },
	...(pub.doi ? { identifier: { '@type': 'PropertyValue', propertyID: 'doi', value: pub.doi } } : {}),
	url: pub.url ?? pageUrl,
	...(pdfAbsUrl ? { contentUrl: pdfAbsUrl, encodingFormat: 'application/pdf' } : {}),
	abstract: pub.abstract,
	keywords: pub.keywords.join(', '),
};

const citation = `${pub.authors.join(', ')}. "${pub.title}." ${pub.venue}, ${pub.date.slice(0, 4)}${pub.doi ? `. doi:${pub.doi}` : ''}.`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{pub.title} — Jaime Yan</title>
		<meta name="description" content={pub.abstract.slice(0, 155)} />
		<link rel="canonical" href={pageUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<!-- Highwire Press tags for Google Scholar (all three required tags present) -->
		<meta name="citation_title" content={pub.title} />
		{pub.authors.map(name => <meta name="citation_author" content={name} />)}
		<meta name="citation_publication_date" content={citationDate(pub)} />
		{venueTag && <meta name={venueTag} content={pub.venue} />}
		{pub.doi && <meta name="citation_doi" content={pub.doi} />}
		{pdfAbsUrl && <meta name="citation_pdf_url" content={pdfAbsUrl} />}

		<!-- Open Graph -->
		<meta property="og:type" content="article" />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:title" content={pub.title} />
		<meta property="og:description" content={pub.abstract.slice(0, 200)} />
		<meta property="og:image" content="https://jaimeyan.com/og.png" />
		<meta name="twitter:card" content="summary" />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
	</head>
	<body class="bg-[#fafaf9] text-stone-900">
		<main class="max-w-3xl mx-auto px-6 py-16 sm:py-24">
			<a href="/#publications" class="text-sm text-stone-500 hover:text-stone-900 transition-colors">← All publications</a>

			<p class="eyebrow mt-10 mb-3">{pub.type === 'journal' ? 'Journal Article' : pub.type === 'conference' ? 'Conference Paper' : pub.type === 'poster' ? 'Poster' : 'Preprint'}</p>
			<h1 class="font-display text-3xl sm:text-4xl font-medium tracking-tight leading-tight">{pub.title}</h1>

			<p class="mt-4 text-stone-600">{pub.authors.join(', ')}</p>
			<p class="mt-1 text-sm text-stone-500">
				{pub.venue} · {pub.date.slice(0, 4)}{pub.paperId ? ` · ${pub.paperId}` : ''}{pub.note ? ` · ${pub.note}` : ''}
			</p>

			<div class="flex flex-wrap gap-3 mt-6">
				{pub.doi && (
					<a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener" class="text-sm font-medium text-white bg-stone-900 hover:bg-stone-700 px-4 py-2 rounded-md transition-colors">DOI · {pub.doi}</a>
				)}
				{pub.url && !pub.doi && (
					<a href={pub.url} target="_blank" rel="noopener" class="text-sm font-medium text-white bg-stone-900 hover:bg-stone-700 px-4 py-2 rounded-md transition-colors">Publisher link</a>
				)}
				{pub.pdfUrl && (
					<a href={pub.pdfUrl} target="_blank" rel="noopener" class="text-sm font-medium text-rose-800 border border-rose-300 hover:border-rose-800 px-4 py-2 rounded-md transition-colors">Download PDF</a>
				)}
				{pub.codeUrl && (
					<a href={pub.codeUrl} target="_blank" rel="noopener" class="text-sm font-medium text-rose-800 border border-rose-300 hover:border-rose-800 px-4 py-2 rounded-md transition-colors">Companion code</a>
				)}
			</div>

			<h2 class="text-xs font-semibold uppercase tracking-widest text-stone-500 mt-12 mb-3">Abstract</h2>
			<p class="leading-relaxed text-stone-700">{pub.abstract}</p>

			<h2 class="text-xs font-semibold uppercase tracking-widest text-stone-500 mt-10 mb-3">Keywords</h2>
			<p class="text-sm text-stone-600">{pub.keywords.join(' · ')}</p>

			<h2 class="text-xs font-semibold uppercase tracking-widest text-stone-500 mt-10 mb-3">Cite</h2>
			<p class="text-sm text-stone-600 leading-relaxed border-l-2 border-stone-200 pl-4">{citation}</p>
		</main>
	</body>
</html>
