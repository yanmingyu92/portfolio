---
// Individual blog post page.
import '../../styles/global.css';
import { getCollection, render } from 'astro:content';
import { getPublication } from '../../data/publications';
import Newsletter from '../../components/Newsletter.astro';

export async function getStaticPaths() {
	const posts = await getCollection('posts', ({ data }) => !data.draft);
	return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const canonical = `https://jaimeyan.com/blog/${post.id}.html`;
const related = post.data.paperRef ? getPublication(post.data.paperRef) : undefined;
const words = (post.body || '').split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(words / 200));

// Series context: prev/next within the same series, ordered by seriesOrder.
const SERIES_TITLE = 'Clinical SP Bootcamp';
let seriesPrev: typeof post | undefined;
let seriesNext: typeof post | undefined;
let seriesIndex = 0;
let seriesTotal = 0;
if (post.data.series) {
	const all = await getCollection('posts', ({ data }) => !data.draft && data.series === post.data.series);
	const ordered = all.sort((a, b) => (a.data.seriesOrder ?? 99) - (b.data.seriesOrder ?? 99));
	seriesTotal = ordered.length;
	seriesIndex = ordered.findIndex(p => p.id === post.id);
	if (seriesIndex > 0) seriesPrev = ordered[seriesIndex - 1];
	if (seriesIndex >= 0 && seriesIndex < ordered.length - 1) seriesNext = ordered[seriesIndex + 1];
}

const jsonLd: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@type': 'TechArticle',
	headline: post.data.title,
	description: post.data.description,
	datePublished: post.data.date.toISOString(),
	url: canonical,
	author: { '@type': 'Person', name: 'Jaime Yan', url: 'https://jaimeyan.com' },
	keywords: post.data.tags.join(', '),
};
if (post.data.series) {
	jsonLd.isPartOf = {
		'@type': 'CreativeWorkSeries',
		name: SERIES_TITLE,
		url: 'https://jaimeyan.com/blog.html#bootcamp',
	};
}
if (post.data.kind === 'tutorial') jsonLd.articleSection = SERIES_TITLE;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{post.data.title} — Jaime Yan</title>
		<meta name="description" content={post.data.description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta property="og:type" content="article" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={post.data.title} />
		<meta property="og:description" content={post.data.description} />
		<meta property="og:image" content="https://jaimeyan.com/og.png" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body class="bg-[#fafaf9] text-stone-900">
		<main class="max-w-3xl mx-auto px-6 py-16 sm:py-24">
		<a href="/blog.html" class="text-sm text-stone-500 hover:text-stone-900 transition-colors">← All posts</a>
		{post.data.series && (
			<p class="mt-10 text-xs font-mono text-rose-800">
				<a href="/blog.html#bootcamp" class="hover:underline">{SERIES_TITLE}</a>
				{post.data.seriesOrder !== undefined && <span class="text-stone-500"> · Part {post.data.seriesOrder}</span>}
			</p>
		)}
		<p class={(post.data.series ? 'mt-1' : 'mt-10') + " text-xs font-mono text-stone-500"}>
				{post.data.date.toISOString().slice(0, 10)} · {readingTime} min read
			</p>
			<h1 class="mt-2 font-display text-3xl sm:text-4xl font-medium tracking-tight leading-tight">{post.data.title}</h1>
			{post.data.tags.length > 0 && (
				<p class="mt-3 text-xs text-stone-500">
					{post.data.tags.map(t => (
						<a href={`/tags/${t}.html`} class="mr-2 text-stone-500 hover:text-rose-800 no-underline">#{t}</a>
					))}
				</p>
			)}

			<article class="prose-custom mt-8 leading-relaxed text-stone-700">
				<Content />
			</article>

			{related && (
				<aside class="mt-12 border-l-2 border-rose-300 pl-4">
					<p class="text-xs font-semibold uppercase tracking-widest text-stone-500 mb-1">Related publication</p>
					<a href={`/papers/${related.slug}.html`} class="text-rose-800 hover:underline font-medium">{related.title}</a>
					<p class="text-sm text-stone-500 mt-1">{related.venue} · {related.date.slice(0, 4)}</p>
				</aside>
			)}

			{(seriesPrev || seriesNext) && (
				<nav class="series-nav" aria-label="Series navigation">
					<div>
						{seriesPrev && (
							<>
								<span class="series-nav-label">← Previous</span><br />
								<a href={`/blog/${seriesPrev.id}.html`}>{seriesPrev.data.title}</a>
							</>
						)}
					</div>
					<div style="text-align: right;">
						{seriesNext && (
							<>
								<span class="series-nav-label">Next →</span><br />
								<a href={`/blog/${seriesNext.id}.html`}>{seriesNext.data.title}</a>
							</>
						)}
					</div>
				</nav>
			)}

			<p class="mt-10 text-sm text-stone-500">
				Originally published at <a href={canonical} class="text-rose-800 hover:underline">jaimeyan.com</a>.
			</p>

			<Newsletter />
		</main>
	</body>
</html>
