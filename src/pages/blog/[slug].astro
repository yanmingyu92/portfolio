---
// Individual blog post page.
import '../../styles/global.css';
import { getCollection, render } from 'astro:content';
import { getPublication } from '../../data/publications';
import { seriesLines, seriesSlugify } from '../../data/bootcamp-lines';
import Newsletter from '../../components/Newsletter.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';

export async function getStaticPaths() {
	const posts = await getCollection('posts', ({ data }) => !data.draft);
	return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const canonical = `https://jaimeyan.com/blog/${post.id}.html`;
const related = post.data.paperRef ? getPublication(post.data.paperRef) : undefined;
const words = (post.body || '').split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(words / 200));

// Series context: prev/next within the same series, ordered by seriesOrder.
const SERIES_TITLE = 'Clinical SP Bootcamp';
let seriesPrev: typeof post | undefined;
let seriesNext: typeof post | undefined;
let seriesIndex = 0;
let seriesTotal = 0;
let sideGroups: { label: string; items: { id: string; order: number; title: string; current: boolean }[] }[] = [];
if (post.data.series) {
	const all = await getCollection('posts', ({ data }) => !data.draft && data.series === post.data.series);
	const ordered = all.sort((a, b) => (a.data.seriesOrder ?? 99) - (b.data.seriesOrder ?? 99));
	seriesTotal = ordered.length;
	seriesIndex = ordered.findIndex(p => p.id === post.id);
	if (seriesIndex > 0) seriesPrev = ordered[seriesIndex - 1];
	if (seriesIndex >= 0 && seriesIndex < ordered.length - 1) seriesNext = ordered[seriesIndex + 1];

	// Sidebar groups: published parts grouped by content line.
	sideGroups = seriesLines
		.map(g => ({
			label: g.label,
			items: ordered
				.filter(p => g.parts.includes(p.data.seriesOrder ?? -1))
				.map(p => ({ id: p.id, order: p.data.seriesOrder ?? 0, title: p.data.title, current: p.id === post.id })),
		}))
		.filter(g => g.items.length > 0);
}

// In-page TOC: h2 headings extracted server-side; ids assigned client-side with the same slugify.
const isTutorial = post.data.kind === 'tutorial';
const tocItems = isTutorial
	? [...(post.body || '').matchAll(/^## (.+)$/gm)]
		.map(m => m[1].trim())
		.map(t => ({ title: t, id: 'h2-' + seriesSlugify(t) }))
	: [];

const jsonLd: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@type': 'TechArticle',
	headline: post.data.title,
	description: post.data.description,
	datePublished: post.data.date.toISOString(),
	url: canonical,
	author: {
		'@type': 'Person',
		name: 'Jaime Yan',
		url: 'https://jaimeyan.com',
		jobTitle: 'Associate Director, Statistical Programming',
		sameAs: [
			'https://github.com/yanmingyu92',
			'https://www.linkedin.com/in/jaime-y-66312a133/',
			'https://scholar.google.com/citations?user=vo1hv04AAAAJ',
			'https://orcid.org/0009-0007-1786-7259',
		],
	},
	keywords: post.data.tags.join(', '),
};
if (post.data.series) {
	jsonLd.isPartOf = {
		'@type': 'CreativeWorkSeries',
		name: SERIES_TITLE,
		url: 'https://jaimeyan.com/blog.html#bootcamp',
	};
}
if (post.data.kind === 'tutorial') jsonLd.articleSection = SERIES_TITLE;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{post.data.title} — Jaime Yan</title>
		<meta name="description" content={post.data.description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta property="og:type" content="article" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={post.data.title} />
		<meta property="og:description" content={post.data.description} />
		<meta property="og:image" content="https://jaimeyan.com/og.png" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<script defer src="/_vercel/insights/script.js"></script>
	</head>
	<body class="bg-[#fafaf9] text-stone-900">
		<main class:list={[
			'px-6 py-16 sm:py-24',
			isTutorial ? 'mx-auto max-w-3xl xl:max-w-5xl' : 'max-w-3xl mx-auto',
		]}>
		<div class={isTutorial ? 'xl:grid xl:grid-cols-[minmax(0,1fr)_15rem] xl:gap-12' : ''}>
			<div class="min-w-0">
		<a href="/blog.html" class="text-sm text-stone-600 hover:text-stone-900 transition-colors">← All posts</a>
		{post.data.series && (
			<p class="mt-10 text-xs font-mono text-rose-800">
				<a href="/blog.html#bootcamp" class="hover:underline">{SERIES_TITLE}</a>
				{post.data.seriesOrder !== undefined && <span class="text-stone-600"> · {post.data.seriesOrder === 0 ? 'Series intro' : `Part ${post.data.seriesOrder}`}</span>}
			</p>
		)}

		{isTutorial && (
			<nav class="series-chips xl:hidden" aria-label="Jump to series part">
				{sideGroups.flatMap(g => g.items).sort((a, b) => a.order - b.order).map(item => (
					item.current
						? <span class="series-chip current">{item.order === 0 ? 'Intro' : item.order}</span>
						: <a class="series-chip" href={`/blog/${item.id}.html`}>{item.order === 0 ? 'Intro' : item.order}</a>
				))}
			</nav>
		)}

		<p class={(post.data.series ? 'mt-1' : 'mt-10') + " text-xs font-mono text-stone-600"}>
				{post.data.date.toISOString().slice(0, 10)} · {readingTime} min read · By <a href="/#about" class="text-rose-800 hover:underline">Jaime Yan</a>, Associate Director, Statistical Programming
			</p>
			<h1 class="mt-2 font-display text-3xl sm:text-4xl font-medium tracking-tight leading-tight">{post.data.title}</h1>
			{post.data.tags.length > 0 && (
				<p class="mt-3 text-xs text-stone-600">
					{post.data.tags.map(t => (
						<a href={`/tags/${t}.html`} class="mr-2 text-stone-600 hover:text-rose-800 no-underline">#{t}</a>
					))}
				</p>
			)}

		<article class="prose-custom mt-8 leading-relaxed text-stone-700">
			<Content />
		</article>

		{post.data.videoId && <VideoEmbed videoId={post.data.videoId} />}
		{post.data.videoId && (
			<script is:inline>
				// Move the video embed up, right below the TL;DR (first blockquote). Runs before first paint.
				(function () {
					var m = document.getElementById('video-embed-mount');
					var b = document.querySelector('.prose-custom blockquote');
					if (m && b && b.parentNode) b.after(m);
				})();
			</script>
		)}

			{related && (
				<aside class="mt-12 border-l-2 border-rose-300 pl-4">
					<p class="text-xs font-semibold uppercase tracking-widest text-stone-600 mb-1">Related publication</p>
					<a href={`/papers/${related.slug}.html`} class="text-rose-800 hover:underline font-medium">{related.title}</a>
					<p class="text-sm text-stone-600 mt-1">{related.venue} · {related.date.slice(0, 4)}</p>
				</aside>
			)}

			{(seriesPrev || seriesNext) && (
				<nav class="series-nav" aria-label="Series navigation">
					<div>
						{seriesPrev && (
							<>
								<span class="series-nav-label">← Previous</span><br />
								<a href={`/blog/${seriesPrev.id}.html`}>{seriesPrev.data.title}</a>
							</>
						)}
					</div>
					<div style="text-align: right;">
						{seriesNext && (
							<>
								<span class="series-nav-label">Next →</span><br />
								<a href={`/blog/${seriesNext.id}.html`}>{seriesNext.data.title}</a>
							</>
						)}
					</div>
				</nav>
			)}

			<p class="mt-10 text-sm text-stone-600">
				Originally published at <a href={canonical} class="text-rose-800 hover:underline">jaimeyan.com</a>.
			</p>
			<p class="mt-2 text-xs text-stone-600">
				© {post.data.date.getUTCFullYear()} Jaime Yan · <a href="https://creativecommons.org/licenses/by/4.0/" class="text-rose-800 hover:underline" rel="license">CC BY 4.0</a> —
				cite as: Yan, J., "{post.data.title}", jaimeyan.com ({post.data.date.toISOString().slice(0, 10)}).
				{isTutorial && <>Series archived on Zenodo: <a href="https://doi.org/10.5281/zenodo.22233175" class="text-rose-800 hover:underline">10.5281/zenodo.22233175</a>.</>}
			</p>

			<Newsletter />
			</div>

			{isTutorial && (
				<aside class="series-sidebar" aria-label="Series navigation">
					<p class="eyebrow mb-2">{SERIES_TITLE}</p>
					{sideGroups.map(g => (
						<div class="series-side-group">
							<p class="series-side-label">{g.label}</p>
							{g.items.map(item => (
								item.current
									? <span class="series-side-item current"><span class="n">{item.order === 0 ? '·' : item.order}</span>{item.title}</span>
									: <a class="series-side-item" href={`/blog/${item.id}.html`}><span class="n">{item.order === 0 ? '·' : item.order}</span>{item.title}</a>
							))}
						</div>
					))}
					{tocItems.length > 0 && (
						<div class="series-side-group">
							<p class="series-side-label">On this page</p>
							<nav class="series-toc">
								{tocItems.map(t => <a href={`#${t.id}`}>{t.title}</a>)}
							</nav>
						</div>
					)}
				</aside>
			)}
		</div>
		</main>

		{isTutorial && (
			<script>
				// Assign h2 ids deterministically (matches server-side slugify) + TOC scroll-spy.
				const slugify = s => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
				const used = new Set();
				document.querySelectorAll('.prose-custom h2').forEach(h => {
					let id = 'h2-' + slugify(h.textContent || '');
					while (used.has(id)) id += '-x';
					used.add(id);
					h.id = id;
				});
				const links = [...document.querySelectorAll('.series-toc a')];
				if (links.length) {
					const map = new Map(links.map(a => [a.getAttribute('href').slice(1), a]));
					const spy = new IntersectionObserver(entries => {
						for (const e of entries) {
							if (e.isIntersecting) {
								links.forEach(a => a.classList.remove('active'));
								map.get(e.target.id)?.classList.add('active');
							}
						}
					}, { rootMargin: '-10% 0px -80% 0px' });
					document.querySelectorAll('.prose-custom h2[id]').forEach(h => spy.observe(h));
				}
			</script>
		)}
	</body>
</html>
