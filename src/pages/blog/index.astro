---
// Blog index — lists published posts from content/posts.
import '../../styles/global.css';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const postHref = (id: string) => `/blog/${id}.html`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Writing — Jaime Yan</title>
		<meta name="description" content="Technical writing on AI/LLM automation for clinical trial statistical programming, CDISC standards, and agentic systems." />
		<link rel="canonical" href="https://jaimeyan.com/blog.html" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate" type="application/rss+xml" title="Jaime Yan — Writing" href="/rss.xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
	</head>
	<body class="bg-[#fafaf9] text-stone-900">
		<main class="max-w-3xl mx-auto px-6 py-16 sm:py-24">
			<a href="/" class="text-sm text-stone-500 hover:text-stone-900 transition-colors">← Home</a>
			<p class="eyebrow mt-10 mb-3">Writing</p>
			<h1 class="font-display text-3xl sm:text-4xl font-medium tracking-tight">Technical Blog</h1>
			<p class="mt-3 text-stone-600 leading-relaxed">
				Notes on LLM agents, clinical trial programming automation, and CDISC data standards —
				extended companions to my <a href="/#publications" class="text-rose-800 hover:underline">published research</a>.
			</p>

			<div class="divide-y divide-stone-200 border-t border-b border-stone-200 mt-10">
				{posts.length === 0 && <p class="py-6 text-sm text-stone-500">First posts are in the pipeline.</p>}
				{posts.map(post => (
					<article class="py-6">
						<p class="text-xs font-mono text-stone-500">{post.data.date.toISOString().slice(0, 10)}</p>
						<h2 class="mt-1 text-lg font-medium leading-snug">
							<a href={postHref(post.id)} class="hover:text-rose-800 transition-colors">{post.data.title}</a>
						</h2>
						<p class="mt-1 text-sm text-stone-600 leading-relaxed">{post.data.description}</p>
						{post.data.tags.length > 0 && (
							<p class="mt-2 text-xs text-stone-500">{post.data.tags.map(t => `#${t}`).join(' ')}</p>
						)}
					</article>
				))}
			</div>
		</main>
	</body>
</html>
