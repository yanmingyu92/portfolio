---
// Blog index — lists published posts from content/posts.
import '../../styles/global.css';
import { getCollection } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import Newsletter from '../../components/Newsletter.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const explainers = posts.filter(p => p.data.kind === 'explainer');
const surveys = posts.filter(p => p.data.kind === 'survey');
const deepDives = posts.filter(p => p.data.kind === 'deep-dive');
const notes = posts.filter(p => p.data.kind === 'note');
const tutorials = posts.filter(p => p.data.kind === 'tutorial')
	.sort((a, b) => (a.data.seriesOrder ?? 99) - (b.data.seriesOrder ?? 99));
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Writing — Jaime Yan</title>
		<meta name="description" content="Technical writing on AI/LLM automation for clinical trial statistical programming, CDISC standards, and agentic systems." />
		<link rel="canonical" href="https://jaimeyan.com/blog.html" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate" type="application/rss+xml" title="Jaime Yan — Writing" href="/rss.xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
	</head>
	<body class="bg-[#fafaf9] text-stone-900">
		<main class="max-w-3xl mx-auto px-6 py-16 sm:py-24">
			<a href="/" class="text-sm text-stone-600 hover:text-stone-900 transition-colors">← Home</a>
			<p class="eyebrow mt-10 mb-3">Writing</p>
			<h1 class="font-display text-3xl sm:text-4xl font-medium tracking-tight">Technical Blog</h1>
			<p class="mt-3 text-stone-600 leading-relaxed">
				Notes on LLM agents, clinical trial programming automation, and CDISC data standards —
				extended companions to my <a href="/#publications" class="text-rose-800 hover:underline">published research</a>.
			</p>

			{surveys.length > 0 && (
				<section class="mt-12">
					<p class="eyebrow mb-1">State of the Field</p>
					<p class="text-sm text-stone-600 mb-4">Quarterly surveys of the evidence — what's proven, what's hype, with full references.</p>
					<div class="divide-y divide-stone-200 border-t border-b border-stone-200">
						{surveys.map(post => <PostCard post={post} />)}
					</div>
				</section>
			)}

			{explainers.length > 0 && (
				<section class="mt-12">
					<p class="eyebrow mb-1">Field Guides &amp; Hot Topics</p>
					<p class="text-sm text-stone-600 mb-4">Practical explainers on the tools and debates shaping clinical programming today.</p>
					<div class="divide-y divide-stone-200 border-t border-b border-stone-200">
						{explainers.map(post => <PostCard post={post} />)}
					</div>
				</section>
			)}

			{tutorials.length > 0 && (
				<section class="mt-12" id="bootcamp">
					<p class="eyebrow mb-1">Clinical SP Bootcamp</p>
					<p class="text-sm text-stone-600 mb-4">A systematic training series: fundamentals, modern SCE workflow, and the agentic way — from raw data to TLF delivery. Key parts ship a downloadable Claude skill.</p>
					<div class="divide-y divide-stone-200 border-t border-b border-stone-200">
						{tutorials.map(post => <PostCard post={post} part={post.data.seriesOrder} />)}
					</div>
				</section>
			)}

			{notes.length > 0 && (
				<section class="mt-12">
					<p class="eyebrow mb-1">Notes</p>
					<p class="text-sm text-stone-600 mb-4">Short, frequent observations — tools, papers, and field notes. Longer arguments live in the sections above.</p>
					<div class="divide-y divide-stone-200 border-t border-b border-stone-200">
						{notes.map(post => <PostCard post={post} />)}
					</div>
				</section>
			)}

			<section class="mt-12">
				<p class="eyebrow mb-1">Research Deep-Dives</p>
				<p class="text-sm text-stone-600 mb-4">Extended companions to the published papers — methods, results, and honest limitations.</p>
				<div class="divide-y divide-stone-200 border-t border-b border-stone-200">
					{deepDives.length === 0 && <p class="py-6 text-sm text-stone-600">First posts are in the pipeline.</p>}
					{deepDives.map(post => <PostCard post={post} />)}
				</div>
			</section>

			<Newsletter />
		</main>
	</body>
</html>
