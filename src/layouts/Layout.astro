---
import '../styles/global.css';

const { title = 'Jaime Yan - Senior Statistical Programmer & AI Researcher' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Jaime Yan - Senior Statistical Programmer at Merck, PhD Candidate in Data Science, expert in AI/LLM applications in clinical trials" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-gray-50 text-gray-900">
		<div class="min-h-screen">
			<slot />
		</div>
	</body>
</html>
