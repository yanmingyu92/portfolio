---
// Experience Section Component
---

<section id="experience" class="py-20 bg-gray-50">
	<div class="max-w-6xl mx-auto px-6">
		<h2 class="text-4xl font-bold text-center mb-12 text-gray-900">Professional Experience</h2>

		<div class="space-y-8">
			<!-- Merck -->
			<div class="bg-white p-8 rounded-xl shadow-md hover:shadow-lg transition-shadow">
				<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4">
					<h3 class="text-2xl font-bold text-gray-900">Senior Statistical Programmer</h3>
					<span class="text-blue-600 font-semibold">Rahway, NJ</span>
				</div>
				<p class="text-xl text-blue-700 font-semibold mb-4">Merck & Co., Inc.</p>
				<ul class="text-gray-700 space-y-2">
					<li class="flex items-start gap-2">
						<span class="text-blue-600 mt-1">▸</span>
						<span>Lead statistical programming for clinical trials using SAS and R</span>
					</li>
					<li class="flex items-start gap-2">
						<span class="text-blue-600 mt-1">▸</span>
						<span>Develop AI/LLM solutions to automate TLF generation workflows</span>
					</li>
					<li class="flex items-start gap-2">
						<span class="text-blue-600 mt-1">▸</span>
						<span>Implement CDISC SDTM and ADaM standards for clinical data</span>
					</li>
					<li class="flex items-start gap-2">
						<span class="text-blue-600 mt-1">▸</span>
						<span>Collaborate with cross-functional teams on data analysis and reporting</span>
					</li>
				</ul>
			</div>

			<!-- Academic Experience -->
			<div class="bg-white p-8 rounded-xl shadow-md hover:shadow-lg transition-shadow">
				<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4">
					<h3 class="text-2xl font-bold text-gray-900">PhD Candidate - Data Science</h3>
					<span class="text-blue-600 font-semibold">Harrisburg, PA</span>
				</div>
				<p class="text-xl text-blue-700 font-semibold mb-4">Harrisburg University of Science and Technology</p>
				<ul class="text-gray-700 space-y-2">
					<li class="flex items-start gap-2">
						<span class="text-blue-600 mt-1">▸</span>
						<span>Research: AI/LLM applications in clinical trial statistical programming</span>
					</li>
					<li class="flex items-start gap-2">
						<span class="text-blue-600 mt-1">▸</span>
						<span>Dissertation: ClinAgent - Autonomous architecture for clinical programming automation</span>
					</li>
					<li class="flex items-start gap-2">
						<span class="text-blue-600 mt-1">▸</span>
						<span>Published 12+ peer-reviewed papers in top conferences and journals</span>
					</li>
				</ul>
			</div>

			<!-- Previous Experience -->
			<div class="bg-white p-8 rounded-xl shadow-md hover:shadow-lg transition-shadow">
				<h3 class="text-2xl font-bold text-gray-900 mb-4">Previous Roles</h3>
				<div class="space-y-4">
					<div class="border-l-4 border-blue-600 pl-4">
						<p class="font-semibold text-gray-900">Statistical Programmer / Data Scientist</p>
						<p class="text-gray-600">Multiple pharmaceutical and healthcare organizations</p>
						<p class="text-sm text-gray-500 mt-1">Specialized in statistical analysis, clinical trial programming, and data science applications</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
