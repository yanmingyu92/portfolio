---
// Publications Section — editorial reference list, rendered from src/data/publications.ts
import { byType, AUTHOR } from '../data/publications';

const journals = byType('journal');
const conferences = byType('conference');
const posters = byType('poster');
const preprints = byType('preprint');

const coauthors = (authors: string[]) => {
	const others = authors.filter(a => a !== AUTHOR);
	return others.length ? `with ${others.join(', ')}` : null;
};

// Every entry links to its on-site abstract page (/papers/<slug>.html); the
// abstract page carries the citation_* meta tags and links out to DOI/PDF.
const paperHref = (p: { slug: string }) => `/papers/${p.slug}.html`;

const metaLine = (p: (typeof journals)[number]) =>
	[p.venue, p.date, p.doi ? `doi:${p.doi}` : null, coauthors(p.authors), p.note].filter(Boolean).join(' · ');
---

<section id="publications" class="py-20 sm:py-24">
	<div class="max-w-5xl mx-auto px-6">
		<div class="grid md:grid-cols-[220px_1fr] gap-10">
			<div>
				<p class="eyebrow mb-2">Publications</p>
				<h2 class="font-display text-3xl sm:text-4xl font-medium tracking-tight text-stone-900 mb-4">
					Research &amp; Writing
				</h2>
				<p class="text-sm text-stone-500 leading-relaxed mb-6">
					{journals.length} peer-reviewed journal papers · {conferences.length} conference papers · {posters.length} posters · 15+ preprints &amp; archives
				</p>
				<a href="https://scholar.google.com/citations?user=vo1hv04AAAAJ&hl=en" target="_blank" rel="noopener" class="text-sm font-medium text-rose-800 underline decoration-rose-300 underline-offset-4 hover:decoration-rose-800">
					Google Scholar profile →
				</a>
			</div>

			<div>
				<p class="text-xs text-stone-400 leading-relaxed mb-8">
					All PhUSE / PharmaSUG / CSS works below were conceived, executed, and written solely by Jaime Yan; on multi-name bylines, additional names appear per conference submission policies.
				</p>

				<!-- Journal articles -->
				<h3 class="text-xs font-semibold uppercase tracking-widest text-stone-500 mb-2">Peer-Reviewed Journal Articles — Sole Author</h3>
				<div class="divide-y divide-stone-200 border-t border-b border-stone-200 mb-12">
					{journals.map(p => (
						<div class="py-5">
							<p class="text-stone-900 font-medium leading-snug">
								<a href={paperHref(p)} class="hover:text-rose-800 transition-colors">{p.title}</a>
							</p>
							<p class="text-sm text-stone-500 mt-1">{metaLine(p)}</p>
						</div>
					))}
				</div>

				<!-- Conference papers -->
				<h3 class="text-xs font-semibold uppercase tracking-widest text-stone-500 mb-2">Conference Papers — PhUSE &amp; PharmaSUG</h3>
				<div class="divide-y divide-stone-200 border-t border-b border-stone-200 mb-12">
					{conferences.map(p => (
						<div class="py-4 flex gap-4">
							<span class="text-xs font-mono text-stone-500 pt-1 w-20 flex-shrink-0">{p.paperId}</span>
							<div>
								<p class="text-stone-900 font-medium leading-snug">
									<a href={paperHref(p)} class="hover:text-rose-800 transition-colors">{p.title}</a>
								</p>
								<p class="text-sm text-stone-500 mt-0.5">
									{metaLine(p)}
									{p.codeUrl && <> · <a href={p.codeUrl} target="_blank" rel="noopener" class="text-rose-800 hover:underline">companion code</a></>}
								</p>
							</div>
						</div>
					))}
				</div>

				<!-- Posters -->
				<h3 class="text-xs font-semibold uppercase tracking-widest text-stone-500 mb-2">Posters — PHUSE/FDA Computational Science Symposium</h3>
				<div class="divide-y divide-stone-200 border-t border-b border-stone-200 mb-12">
					{posters.map(p => (
						<div class="py-4 flex gap-4">
							<span class="text-xs font-mono text-stone-500 pt-1 w-20 flex-shrink-0">{p.paperId}</span>
							<div>
								<p class="text-stone-900 font-medium leading-snug">
									<a href={paperHref(p)} class="hover:text-rose-800 transition-colors">{p.title}</a>
								</p>
								<p class="text-sm text-stone-500 mt-0.5">{metaLine(p)}</p>
							</div>
						</div>
					))}
				</div>

				<!-- Preprints -->
				<h3 class="text-xs font-semibold uppercase tracking-widest text-stone-500 mb-2">Selected Preprints &amp; Technical Reports</h3>
				<div class="divide-y divide-stone-200 border-t border-b border-stone-200">
					{preprints.map(p => (
						<div class="py-4">
							<p class="text-stone-900 font-medium leading-snug">
								<a href={paperHref(p)} class="hover:text-rose-800 transition-colors">{p.title}</a>
							</p>
							<p class="text-sm text-stone-500 mt-0.5">{metaLine(p)}</p>
						</div>
					))}
				</div>

				<p class="text-sm text-stone-500 leading-relaxed mt-6">
					Additional archives: 4 TechRxiv preprints (2025) underlying the PHUSE 2025 papers ·
					Graph-Constrained Skill Loading (JMIR Preprints, 2026) · LogicGraph-HL (OSF, 2026) ·
					3 Zenodo software/paper archives (2026)
				</p>
			</div>
		</div>
	</div>
</section>
