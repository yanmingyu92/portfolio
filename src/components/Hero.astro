---
// Hero Section — editorial, left-aligned, with subtle tsParticles background
---

<section class="relative overflow-hidden bg-white border-b border-stone-200 pt-16">
	<!-- tsParticles canvas: pointer-events-none so links stay clickable;
		 interactivity is tracked on window instead -->
	<div id="tsparticles" class="absolute inset-0 pointer-events-none" aria-hidden="true"></div>

	<div class="relative z-10 max-w-5xl mx-auto px-6 py-20 sm:py-28">
		<p class="eyebrow mb-5 hero-reveal">Associate Director, Statistical Programming — Kardigan</p>

		<h1 class="font-display text-6xl sm:text-7xl font-medium tracking-tight text-stone-900 mb-4 hero-reveal">
			Jaime Yan
		</h1>

		<p class="text-lg sm:text-xl font-medium text-stone-900 mb-6 hero-reveal">
			Clinical Data Science Lead · AI/LLM Researcher · Clinical Trials Automation
		</p>

		<p class="text-lg sm:text-xl text-stone-600 leading-relaxed max-w-2xl mb-4 hero-reveal">
			Statistical programming leader with 9+ years in clinical trials, across cardiovascular
			and oncology programs. NDA statistical programming lead for
			<span class="text-stone-900 font-medium">LIPFENDRA&reg; (enlicitide)</span> — the first
			and only oral PCSK9 inhibitor, approved by the FDA in July 2026.
		</p>
		<p class="text-base text-stone-500 max-w-2xl mb-10 hero-reveal">
			PhD candidate in Data Science · Research in AI/LLM automation for clinical trial programming ·
			2 peer-reviewed journal papers, 30+ research outputs
		</p>

		<div class="flex flex-wrap items-center gap-x-8 gap-y-3 mb-16 text-sm hero-reveal">
			<a href="/Jaime_Yan_Resume.pdf" download="Jaime_Yan_Resume.pdf" class="font-medium text-white bg-stone-900 hover:bg-stone-700 px-5 py-2.5 rounded-md transition-colors">
				Download Résumé
			</a>
			<a href="mailto:yanmingyunmt@gmail.com" class="font-medium text-stone-700 underline decoration-stone-300 underline-offset-4 hover:decoration-stone-900 transition-colors">yanmingyunmt@gmail.com</a>
			<a href="https://github.com/yanmingyu92" target="_blank" rel="noopener" class="font-medium text-stone-700 underline decoration-stone-300 underline-offset-4 hover:decoration-stone-900 transition-colors">GitHub</a>
			<a href="https://www.linkedin.com/in/jaime-y-66312a133/" target="_blank" rel="noopener" class="font-medium text-stone-700 underline decoration-stone-300 underline-offset-4 hover:decoration-stone-900 transition-colors">LinkedIn</a>
			<a href="https://scholar.google.com/citations?user=vo1hv04AAAAJ&hl=en" target="_blank" rel="noopener" class="font-medium text-stone-700 underline decoration-stone-300 underline-offset-4 hover:decoration-stone-900 transition-colors">Google Scholar</a>
		</div>

		<div class="grid grid-cols-2 md:grid-cols-4 gap-8 border-t border-stone-200 pt-8 hero-reveal">
			<div>
				<div class="font-display text-3xl font-medium text-stone-900">9+</div>
				<p class="text-sm text-stone-500 mt-1">Years in clinical trials</p>
			</div>
			<div>
				<div class="font-display text-3xl font-medium text-stone-900">30+</div>
				<p class="text-sm text-stone-500 mt-1">Research outputs</p>
			</div>
			<div>
				<div class="font-display text-3xl font-medium text-stone-900">2</div>
				<p class="text-sm text-stone-500 mt-1">Peer-reviewed journal papers</p>
			</div>
			<div>
				<div class="font-display text-3xl font-medium text-stone-900">13</div>
				<p class="text-sm text-stone-500 mt-1">Conference papers</p>
			</div>
		</div>
	</div>
</section>

<script>
	import { tsParticles } from "@tsparticles/engine";
	import { loadFull } from "tsparticles";

	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	if (!reduceMotion) {
		await loadFull(tsParticles);
		await tsParticles.load({
			id: "tsparticles",
			options: {
				fullScreen: false,
				fpsLimit: 60,
				detectRetina: true,
				background: { color: { value: "transparent" } },
				particles: {
					number: {
						value: 55,
						density: { enable: true, width: 1100, height: 700 },
					},
					color: { value: ["#a8a29e", "#9f1239"] },
					shape: { type: "circle" },
					opacity: {
						value: { min: 0.15, max: 0.4 },
					},
					size: { value: { min: 1, max: 2.5 } },
					links: {
						enable: true,
						distance: 130,
						color: "#a8a29e",
						opacity: 0.18,
						width: 1,
					},
					move: {
						enable: true,
						speed: 0.5,
						direction: "none",
						random: true,
						straight: false,
						outModes: { default: "out" },
					},
				},
				interactivity: {
					detectsOn: "window",
					events: {
						onHover: { enable: true, mode: "grab" },
						resize: { enable: true },
					},
					modes: {
						grab: {
							distance: 150,
							links: { opacity: 0.3, color: "#9f1239" },
						},
					},
				},
			},
		});
	}
</script>

<style>
	/* Staggered entrance — respects reduced-motion */
	.hero-reveal {
		opacity: 0;
		transform: translateY(14px);
		animation: hero-fade-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
	}
	.hero-reveal:nth-child(1) { animation-delay: 0.05s; }
	.hero-reveal:nth-child(2) { animation-delay: 0.12s; }
	.hero-reveal:nth-child(3) { animation-delay: 0.19s; }
	.hero-reveal:nth-child(4) { animation-delay: 0.26s; }
	.hero-reveal:nth-child(5) { animation-delay: 0.33s; }
	.hero-reveal:nth-child(6) { animation-delay: 0.4s; }
	.hero-reveal:nth-child(7) { animation-delay: 0.47s; }

	@keyframes hero-fade-up {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-reveal {
			opacity: 1;
			transform: none;
			animation: none;
		}
	}
</style>
