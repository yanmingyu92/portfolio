---
// Skills Section Component
---

<section id="skills" class="py-20 bg-white">
	<div class="max-w-6xl mx-auto px-6">
		<h2 class="text-4xl font-bold text-center mb-12 text-gray-900">Technical Skills</h2>

		<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
			<!-- Programming Languages -->
			<div class="bg-gradient-to-br from-blue-50 to-indigo-50 p-6 rounded-xl">
				<div class="flex items-center gap-3 mb-4">
					<div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center">
						<svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
					</div>
					<h3 class="text-xl font-bold text-gray-900">Programming</h3>
				</div>
				<ul class="space-y-2">
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-blue-600 rounded-full"></span>
						<span class="text-gray-700">SAS (Advanced)</span>
					</li>
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-blue-600 rounded-full"></span>
						<span class="text-gray-700">R (Advanced)</span>
					</li>
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-blue-600 rounded-full"></span>
						<span class="text-gray-700">Python (Advanced)</span>
					</li>
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-blue-600 rounded-full"></span>
						<span class="text-gray-700">SQL</span>
					</li>
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-blue-600 rounded-full"></span>
						<span class="text-gray-700">JavaScript/TypeScript</span>
					</li>
				</ul>
			</div>

			<!-- AI/ML -->
			<div class="bg-gradient-to-br from-purple-50 to-pink-50 p-6 rounded-xl">
				<div class="flex items-center gap-3 mb-4">
					<div class="w-10 h-10 bg-purple-600 rounded-lg flex items-center justify-center">
						<svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>
					</div>
					<h3 class="text-xl font-bold text-gray-900">AI & Machine Learning</h3>
				</div>
				<ul class="space-y-2">
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-purple-600 rounded-full"></span>
						<span class="text-gray-700">Large Language Models (LLMs)</span>
					</li>
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-purple-600 rounded-full"></span>
						<span class="text-gray-700">GPT, Claude, Llama</span>
					</li>
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-purple-600 rounded-full"></span>
						<span class="text-gray-700">Fine-tuning & Prompt Engineering</span>
					</li>
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-purple-600 rounded-full"></span>
						<span class="text-gray-700">LangChain</span>
					</li>
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-purple-600 rounded-full"></span>
						<span class="text-gray-700">Machine Learning Algorithms</span>
					</li>
				</ul>
			</div>

			<!-- Clinical & Data Standards -->
			<div class="bg-gradient-to-br from-green-50 to-teal-50 p-6 rounded-xl">
				<div class="flex items-center gap-3 mb-4">
					<div class="w-10 h-10 bg-green-600 rounded-lg flex items-center justify-center">
						<svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
					</div>
					<h3 class="text-xl font-bold text-gray-900">Clinical Standards</h3>
				</div>
				<ul class="space-y-2">
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-green-600 rounded-full"></span>
						<span class="text-gray-700">CDISC SDTM</span>
					</li>
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-green-600 rounded-full"></span>
						<span class="text-gray-700">CDISC ADaM</span>
					</li>
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-green-600 rounded-full"></span>
						<span class="text-gray-700">TLF (Tables, Listings, Figures)</span>
					</li>
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-green-600 rounded-full"></span>
						<span class="text-gray-700">Admiral Package (R)</span>
					</li>
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-green-600 rounded-full"></span>
						<span class="text-gray-700">Clinical Trial Data Management</span>
					</li>
				</ul>
			</div>

			<!-- Databases -->
			<div class="bg-gradient-to-br from-orange-50 to-red-50 p-6 rounded-xl">
				<div class="flex items-center gap-3 mb-4">
					<div class="w-10 h-10 bg-orange-600 rounded-lg flex items-center justify-center">
						<svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path></svg>
					</div>
					<h3 class="text-xl font-bold text-gray-900">Databases</h3>
				</div>
				<ul class="space-y-2">
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-orange-600 rounded-full"></span>
						<span class="text-gray-700">Neo4j (Graph Database)</span>
					</li>
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-orange-600 rounded-full"></span>
						<span class="text-gray-700">PostgreSQL</span>
					</li>
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-orange-600 rounded-full"></span>
						<span class="text-gray-700">MySQL</span>
					</li>
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-orange-600 rounded-full"></span>
						<span class="text-gray-700">Knowledge Graphs</span>
					</li>
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-orange-600 rounded-full"></span>
						<span class="text-gray-700">Cypher Query Language</span>
					</li>
				</ul>
			</div>

			<!-- Tools & Platforms -->
			<div class="bg-gradient-to-br from-indigo-50 to-blue-50 p-6 rounded-xl">
				<div class="flex items-center gap-3 mb-4">
					<div class="w-10 h-10 bg-indigo-600 rounded-lg flex items-center justify-center">
						<svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"></path></svg>
					</div>
					<h3 class="text-xl font-bold text-gray-900">Tools & Platforms</h3>
				</div>
				<ul class="space-y-2">
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-indigo-600 rounded-full"></span>
						<span class="text-gray-700">Git & GitHub</span>
					</li>
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-indigo-600 rounded-full"></span>
						<span class="text-gray-700">Dataiku</span>
					</li>
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-indigo-600 rounded-full"></span>
						<span class="text-gray-700">Docker</span>
					</li>
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-indigo-600 rounded-full"></span>
						<span class="text-gray-700">Jupyter Notebooks</span>
					</li>
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-indigo-600 rounded-full"></span>
						<span class="text-gray-700">Linux/Unix</span>
					</li>
				</ul>
			</div>

			<!-- Soft Skills -->
			<div class="bg-gradient-to-br from-teal-50 to-cyan-50 p-6 rounded-xl">
				<div class="flex items-center gap-3 mb-4">
					<div class="w-10 h-10 bg-teal-600 rounded-lg flex items-center justify-center">
						<svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
					</div>
					<h3 class="text-xl font-bold text-gray-900">Expertise</h3>
				</div>
				<ul class="space-y-2">
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-teal-600 rounded-full"></span>
						<span class="text-gray-700">Statistical Programming</span>
					</li>
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-teal-600 rounded-full"></span>
						<span class="text-gray-700">Research & Development</span>
					</li>
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-teal-600 rounded-full"></span>
						<span class="text-gray-700">Technical Leadership</span>
					</li>
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-teal-600 rounded-full"></span>
						<span class="text-gray-700">Cross-functional Collaboration</span>
					</li>
					<li class="flex items-center gap-2">
						<span class="w-2 h-2 bg-teal-600 rounded-full"></span>
						<span class="text-gray-700">Problem Solving</span>
					</li>
				</ul>
			</div>
		</div>
	</div>
</section>
