---
// Projects Section Component
---

<section id="projects" class="py-20 bg-gray-50">
	<div class="max-w-6xl mx-auto px-6">
		<h2 class="text-4xl font-bold text-center mb-4 text-gray-900">Featured Projects</h2>
		<p class="text-center text-gray-600 mb-12 text-lg">Innovative solutions in clinical trials automation and compliance</p>

		<div class="grid md:grid-cols-2 gap-8">
			<!-- Project 1: Compliance Email Webapp -->
			<div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-all">
				<div class="h-3 bg-gradient-to-r from-blue-600 to-indigo-600"></div>
				<div class="p-8">
					<div class="flex items-center gap-3 mb-4">
						<span class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
							<svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
						</span>
						<h3 class="text-2xl font-bold text-gray-900">Compliance Email Analysis System</h3>
					</div>
					<p class="text-gray-700 mb-4 leading-relaxed">
						Developed a comprehensive web application for automated compliance checking of email communications using Large Language Models.
					</p>
					<div class="mb-6">
						<h4 class="font-semibold text-gray-900 mb-2">Key Features:</h4>
						<ul class="text-gray-600 space-y-1 text-sm">
							<li>• PST file parsing and email content extraction</li>
							<li>• User-defined compliance rule configuration</li>
							<li>• LLM-powered content analysis and violation detection</li>
							<li>• Automated compliance report generation</li>
							<li>• Interactive dashboard for review and approval</li>
						</ul>
					</div>
					<div class="mb-6">
						<h4 class="font-semibold text-gray-900 mb-2">Technology Stack:</h4>
						<div class="flex flex-wrap gap-2">
							<span class="px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-sm font-medium">Python</span>
							<span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm font-medium">LLM</span>
							<span class="px-3 py-1 bg-yellow-100 text-yellow-700 rounded-full text-sm font-medium">HTML/CSS/JS</span>
							<span class="px-3 py-1 bg-purple-100 text-purple-700 rounded-full text-sm font-medium">Dataiku</span>
							<span class="px-3 py-1 bg-red-100 text-red-700 rounded-full text-sm font-medium">PST Processing</span>
						</div>
					</div>
					<a href="https://github.com/yanmingyu92" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-800 font-semibold">
						View on GitHub
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
					</a>
				</div>
			</div>

			<!-- Project 2: ClinAgent -->
			<div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-all">
				<div class="h-3 bg-gradient-to-r from-green-600 to-teal-600"></div>
				<div class="p-8">
					<div class="flex items-center gap-3 mb-4">
						<span class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
							<svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
						</span>
						<h3 class="text-2xl font-bold text-gray-900">ClinAgent</h3>
					</div>
					<p class="text-gray-700 mb-4 leading-relaxed">
						A revolutionary five-layer autonomous architecture for automating clinical trial statistical programming, reducing Phase 3 study workload from 12-24 FTE-months to days.
					</p>
					<div class="mb-6">
						<h4 class="font-semibold text-gray-900 mb-2">Key Features:</h4>
						<ul class="text-gray-600 space-y-1 text-sm">
							<li>• Autonomous TLF (Tables, Listings, Figures) generation</li>
							<li>• Multi-layer LLM orchestration system</li>
							<li>• CDISC SDTM and ADaM standard compliance</li>
							<li>• Self-debugging and validation pipeline</li>
							<li>• Integration with SAS and R ecosystems</li>
						</ul>
					</div>
					<div class="mb-6">
						<h4 class="font-semibold text-gray-900 mb-2">Technology Stack:</h4>
						<div class="flex flex-wrap gap-2">
							<span class="px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-sm font-medium">LLMs</span>
							<span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm font-medium">SAS</span>
							<span class="px-3 py-1 bg-purple-100 text-purple-700 rounded-full text-sm font-medium">R/Admiral</span>
							<span class="px-3 py-1 bg-orange-100 text-orange-700 rounded-full text-sm font-medium">CDISC</span>
						</div>
					</div>
					<a href="https://www.medrxiv.org/content/10.64898/2026.01.09.26343542v1" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-green-600 hover:text-green-800 font-semibold">
						Read Paper
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
					</a>
				</div>
			</div>

			<!-- Project 3: LLM Code Generation -->
			<div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-all">
				<div class="h-3 bg-gradient-to-r from-purple-600 to-pink-600"></div>
				<div class="p-8">
					<div class="flex items-center gap-3 mb-4">
						<span class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
							<svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
						</span>
						<h3 class="text-2xl font-bold text-gray-900">LLM Code Generation Pipeline</h3>
					</div>
					<p class="text-gray-700 mb-4 leading-relaxed">
						End-to-end methodology for fine-tuning small language models to generate executable R code for the Admiral package in statistical programming.
					</p>
					<div class="mb-6">
						<h4 class="font-semibold text-gray-900 mb-2">Key Features:</h4>
						<ul class="text-gray-600 space-y-1 text-sm">
							<li>• Custom fine-tuning pipeline for small LLMs</li>
							<li>• Admiral R code generation and validation</li>
							<li>• Schema-preserving template generation</li>
							<li>• Iterative LLM-guided debugging system</li>
							<li>• SAS to R code conversion automation</li>
						</ul>
					</div>
					<div class="mb-6">
						<h4 class="font-semibold text-gray-900 mb-2">Technology Stack:</h4>
						<div class="flex flex-wrap gap-2">
							<span class="px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-sm font-medium">Python</span>
							<span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm font-medium">R</span>
							<span class="px-3 py-1 bg-purple-100 text-purple-700 rounded-full text-sm font-medium">Fine-tuning</span>
							<span class="px-3 py-1 bg-orange-100 text-orange-700 rounded-full text-sm font-medium">Admiral</span>
						</div>
					</div>
					<a href="https://www.techrxiv.org/users/890813/articles/1274985" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-purple-600 hover:text-purple-800 font-semibold">
						Read Paper
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
					</a>
				</div>
			</div>

			<!-- Project 4: Knowledge Graph Data Query -->
			<div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-all">
				<div class="h-3 bg-gradient-to-r from-orange-600 to-red-600"></div>
				<div class="p-8">
					<div class="flex items-center gap-3 mb-4">
						<span class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center">
							<svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
						</span>
						<h3 class="text-2xl font-bold text-gray-900">Clinical Data Knowledge Graph</h3>
					</div>
					<p class="text-gray-700 mb-4 leading-relaxed">
						Enhancing clinical trial data queries using Large Language Models and Neo4j graph database for improved data exploration and analysis.
					</p>
					<div class="mb-6">
						<h4 class="font-semibold text-gray-900 mb-2">Key Features:</h4>
						<ul class="text-gray-600 space-y-1 text-sm">
							<li>• Neo4j graph database for clinical trial data</li>
							<li>• LLM-powered natural language query interface</li>
							<li>• SQL vs Graph database performance comparison</li>
							<li>• Complex relationship discovery and analysis</li>
							<li>• Synthetic CDISC ADaM dataset generation</li>
						</ul>
					</div>
					<div class="mb-6">
						<h4 class="font-semibold text-gray-900 mb-2">Technology Stack:</h4>
						<div class="flex flex-wrap gap-2">
							<span class="px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-sm font-medium">Neo4j</span>
							<span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm font-medium">LLM</span>
							<span class="px-3 py-1 bg-purple-100 text-purple-700 rounded-full text-sm font-medium">Cypher</span>
							<span class="px-3 py-1 bg-orange-100 text-orange-700 rounded-full text-sm font-medium">SQL</span>
						</div>
					</div>
					<a href="https://www.lexjansen.com/phuse-us/2025/dh/PAP_DH03.pdf" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-orange-600 hover:text-orange-800 font-semibold">
						Read Paper
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
					</a>
				</div>
			</div>
		</div>
	</div>
</section>
